import os.path

binary = AMXX.MetaModule(builder, 'regex')

# PCRE is now built per-arch from tools/pcre/ so the 32-bit-only
# prebuilt lib_<plat>/libpcre.a archives are no longer used. On
# Windows AMBuild path, fall back to the prebuilt for now (msvc12
# project files retain it independently); Phase 2.4's per-arch
# build is Linux/Mac focused.
if builder.target_platform == 'windows':
  binary.compiler.postlink += [binary.Dep('lib_win\\pcre.lib')]
else:
  binary.compiler.linkflags += [AMXX.pcre.binary]
  binary.compiler.includes += [
    os.path.join(builder.sourcePath, 'tools', 'pcre'),
  ]

binary.compiler.defines += [
  'PCRE_STATIC',
  'HAVE_STDINT_H',
]

binary.sources = [
  '../../public/sdk/amxxmodule.cpp',
  'module.cpp',
  'CRegEx.cpp',
  'utils.cpp',
]

if builder.target_platform == 'windows':
  binary.sources += ['version.rc']
  if binary.compiler.vendor == 'msvc' and binary.compiler.version >= 1900:
    binary.sources += [
    '../../public/msvc/msvc15hack.c'
  ]

AMXX.modules += [builder.Add(binary)]
